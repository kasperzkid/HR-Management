generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String
  mustChangePassword  Boolean   @default(false)
  role                String
  employeeId          String?   @unique
  employee            Employee? @relation(fields: [employeeId], references: [id])
  createdAt           DateTime  @default(now())

  sentMessages        Message[] @relation("SentMessages")
  receivedMessages    Message[] @relation("ReceivedMessages")
}

model Employee {
  id                 String   @id
  employeeId         String   @unique
  name               String
  gender             String
  dateOfBirth        String
  joinDate           String
  jobTitle           String
  department         String
  employmentType     String
  basicSalary        Float
  transportAllowance Float
  housingAllowance   Float
  mealAllowance      Float
  otherAllowance     Float
  otherDeductions    Float
  loanDeductions     Float
  bankName           String
  bankAccount        String
  tin                String
  pensionId          String
  phone              String
  ethioTelecomPhone  String   @default("")
  email              String
  address            String
  emergencyContact   String
  employmentStatus   String
  exitDate           String?
  notes              String?
  status             String
  avatar             String
  location           String
  salary             Float
  manager            String
  roleType            String
  initials             String
  githubUrl          String   @default("")
  linkedinUrl        String   @default("")
  portfolioUrl       String   @default("")
  skills             String   @default("")
    resumeStorageName  String?
    resumeFileName     String?
    resumeMimeType     String?
    resumeFileSize     Int?
  createdAt          DateTime @default(now())

  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]
  user           User?
}

model Attendance {
  id           String @id
  employeeId   String
  employeeName String
  department   String
  date         String

  status String

  checkIn  String?
  checkOut String?

  late           Int @default(0)
  earlyDeparture Int @default(0)

  regular  Float @default(0)
  overtime Float @default(0)

  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInLocationStatus String?

  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutLocationStatus String?

  requiredCheckInTime String?

  reviewStatus  String?
  reviewedBy    String?
  reviewedAt    String?
  reviewRemarks String?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id             String   @id
  employeeId     String
  employeeName   String
  department     String
  leaveType      String
  requestDate    String
  startDate      String
  endDate        String
  days           Float
  approvalStatus String
  approvedBy     String?
  approvedDate   String?
  remarks        String?
  rejectionReason String?
  balance        Float?
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRecord {
  id           String @id
  employeeId   String
  employeeName String
  department   String
  payrollMonth String

  basicSalary        Float
  transportAllowance Float
  housingAllowance   Float
  mealAllowance      Float
  otherAllowance     Float
  overtimePay        Float
  grossSalary        Float

  pensionDeduction Float
  incomeTax        Float
  loanDeduction    Float
  otherDeduction   Float
  totalDeductions  Float
  netSalary        Float

  employerPension Float
  employerCost    Float

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, payrollMonth])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Message {
  id             String   @id @default(uuid())
  senderId       Int
  receiverId     Int
  text           String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  read           Boolean  @default(false)
  isComplain     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}
