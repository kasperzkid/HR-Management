# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
#
#   .env holds the actual secrets and MUST never be committed to git.
#   It is already listed in .gitignore.
#
# This template is committed. Never put a real password or App Password here.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------
# SQLite, resolved relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"


# --- Authentication --------------------------------------------------------
# Signs the login tokens. MUST be changed to a long random value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this is left empty the server falls back to a well-known development
# secret, which is fine locally and unsafe anywhere else.
JWT_SECRET=""


# --- Email (SMTP) ----------------------------------------------------------
# Required for three features:
#   * "Forgot password" - sends the single-use reset link
#   * Confirming a login-email change from Account Settings
#   * Creating an employee - emails their temporary password
#
# All three report a clear error when these are missing. They never pretend an
# email was sent.
#
# Gmail setup
# -----------
# 1. Turn on 2-Step Verification for the sending account:
#      https://myaccount.google.com/security
# 2. Create an App Password:
#      https://myaccount.google.com/apppasswords
#    (Google shows a 16-character password)
# 3. Put that 16-character value in SMTP_PASSWORD below.
#
# Use the App Password, NOT the account password. Gmail rejects the account
# password over SMTP.
#
# Do NOT put the password or App Password in any source file. The frontend
# never receives any of these values.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# "true" for implicit TLS (port 465). Leave as "false" for STARTTLS (port 587).
SMTP_SECURE="false"

# The mailbox that sends the email.
SMTP_USER="your-hr-mailbox@gmail.com"

# The 16-character Google App Password. Leave empty to disable email.
SMTP_PASSWORD=""

# The "From:" header recipients see. Gmail ignores this unless it matches
# SMTP_USER, so keep them the same when sending from Gmail.
SMTP_FROM="YanolTech HR <your-hr-mailbox@gmail.com>"


# --- Public app URL --------------------------------------------------------
# Used to build the password-reset and email-confirmation links inside the
# email. This is the address the APP is served from, not the API port.
# 5173 is the Vite dev server; use your real domain in production.
APP_PUBLIC_URL="http://localhost:5173"


# --- Handing the system to a company ---------------------------------------
# There is no code change or manual database edit involved. The sequence is:
#
#   1. Sign in with the initial HR Admin account.
#   2. HR Settings -> My Account -> enter the company's real email -> Save.
#   3. Open the confirmation link that arrives at the new address. Only then
#      does it become the login address, so a typo cannot lock anyone out.
#   4. In the same card, replace the temporary setup password.
#
# Step 3 needs SMTP to be working. If it is not set up yet, finish it from the
# server console instead - this is the only situation where that is needed, and
# it is deliberately not reachable from the browser:
#
#   npm run auth:confirm-email            # list what is waiting
#   npm run auth:confirm-email <email>    # confirm it
#
# Once SMTP works, press "Resend confirmation" on the settings page instead and
# the emailed link becomes available.
#
# The initial HR Admin email and password are only read at seed time. Neither is
# hard-coded in the application, and neither is ever a default for a new
# account.
SEED_HR_ADMIN_EMAIL="your-hr-mailbox@gmail.com"
SEED_HR_ADMIN_PASSWORD="change-this-before-first-login"
SEED_EMPLOYER_PASSWORD="change-this-before-first-login"
